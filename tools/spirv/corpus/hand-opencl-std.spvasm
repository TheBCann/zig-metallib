OpEntryPoint Kernel %k_smoothstep "smoothstep" %gid
OpEntryPoint Kernel %k_ldexp "ldexp" %gid
OpEntryPoint Kernel %k_s_abs "s_abs" %gid
OpEntryPoint Kernel %k_popcount "popcount" %gid
OpEntryPoint Kernel %k_clz "clz" %gid
OpEntryPoint Kernel %k_ctz "ctz" %gid
OpEntryPoint Kernel %k_s_min "s_min" %gid
OpEntryPoint Kernel %k_s_max "s_max" %gid
OpEntryPoint Kernel %k_s_mul_hi "s_mul_hi" %gid
OpEntryPoint Kernel %k_u_min "u_min" %gid
OpEntryPoint Kernel %k_u_max "u_max" %gid
OpEntryPoint Kernel %k_u_mul_hi "u_mul_hi" %gid
OpEntryPoint Kernel %k_s_clamp "s_clamp" %gid
OpEntryPoint Kernel %k_u_clamp "u_clamp" %gid
OpEntryPoint Kernel %k_normalize "normalize" %gid
OpEntryPoint Kernel %k_length "length" %gid
OpEntryPoint Kernel %k_distance "distance" %gid
OpEntryPoint Kernel %k_cross "cross" %gid
