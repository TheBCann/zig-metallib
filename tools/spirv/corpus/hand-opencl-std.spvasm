OpExecutionMode %k_sqrt LocalSize 64 1 1
OpExecutionMode %k_rsqrt LocalSize 64 1 1
OpExecutionMode %k_floor LocalSize 64 1 1
OpExecutionMode %k_ceil LocalSize 64 1 1
OpExecutionMode %k_trunc LocalSize 64 1 1
