; hand-opencl-std.spvasm: one Kernel entry point per OpenCL.std instruction the lowering maps
; (SPIRV-DESIGN section 4: 'OpenCL.std: the same table by name'), OpenCL flavour as Zig's
; spirv64-opencl target emits it: Kernel/Addresses/Int64 capabilities, Physical64 OpenCL,
; CrossWorkgroup pointer parameters, OpInBoundsPtrAccessChain, GlobalInvocationId as a vec3<u64>.
; Parameters: (in0, in1, out) as CrossWorkgroup f32 pointers for float kernels, i32 for integer
; kernels (unsigned ones bitcast), vec4<f32> for the vector kernels; every kernel handles gid.x.
; Hand-written for this project's corpus in tools/spirv/asm.zig syntax (spirv-as compatible).
; SPIR-V
; Version: 1.3
; Generator: 0x00000000
OpCapability Kernel
OpCapability Addresses
OpCapability Int64
%ocl = OpExtInstImport "OpenCL.std"
OpMemoryModel Physical64 OpenCL
OpEntryPoint Kernel %k_fabs "fabs" %gid
OpEntryPoint Kernel %k_sqrt "sqrt" %gid
OpEntryPoint Kernel %k_rsqrt "rsqrt" %gid
OpEntryPoint Kernel %k_floor "floor" %gid
OpEntryPoint Kernel %k_ceil "ceil" %gid
OpEntryPoint Kernel %k_trunc "trunc" %gid
OpEntryPoint Kernel %k_rint "rint" %gid
OpEntryPoint Kernel %k_round "round" %gid
OpEntryPoint Kernel %k_sin "sin" %gid
OpEntryPoint Kernel %k_cos "cos" %gid
OpEntryPoint Kernel %k_tan "tan" %gid
OpEntryPoint Kernel %k_asin "asin" %gid
OpEntryPoint Kernel %k_acos "acos" %gid
OpEntryPoint Kernel %k_atan "atan" %gid
OpEntryPoint Kernel %k_sinh "sinh" %gid
