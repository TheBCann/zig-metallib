OpName %gid "gid"
OpDecorate %gid BuiltIn GlobalInvocationId
%void = OpTypeVoid
%f32 = OpTypeFloat 32
%u32 = OpTypeInt 32 0
%i32 = OpTypeInt 32 1
%u64 = OpTypeInt 64 0
%v3u64 = OpTypeVector %u64 3
%v4f32 = OpTypeVector %f32 4
%v3f32 = OpTypeVector %f32 3
%f0 = OpConstant %f32 0
%p_cw_f32 = OpTypePointer CrossWorkgroup %f32
%p_cw_i32 = OpTypePointer CrossWorkgroup %i32
%p_cw_v4 = OpTypePointer CrossWorkgroup %v4f32
%fn_f = OpTypeFunction %void %p_cw_f32 %p_cw_f32 %p_cw_f32
%fn_i = OpTypeFunction %void %p_cw_i32 %p_cw_i32 %p_cw_i32
%fn_fi = OpTypeFunction %void %p_cw_f32 %p_cw_i32 %p_cw_f32
%fn_v = OpTypeFunction %void %p_cw_v4 %p_cw_v4 %p_cw_v4
%fn_vs = OpTypeFunction %void %p_cw_v4 %p_cw_v4 %p_cw_f32
%p_in_v3u64 = OpTypePointer Input %v3u64
%gid = OpVariable %p_in_v3u64 Input
%k_fabs = OpFunction %void None %fn_f
%fabs_in0 = OpFunctionParameter %p_cw_f32
%fabs_in1 = OpFunctionParameter %p_cw_f32
%fabs_out = OpFunctionParameter %p_cw_f32
%fabs_entry = OpLabel
%fabs_g = OpLoad %v3u64 %gid
%fabs_i = OpCompositeExtract %u64 %fabs_g 0
%fabs_pa = OpInBoundsPtrAccessChain %p_cw_f32 %fabs_in0 %fabs_i
%fabs_a0 = OpLoad %f32 %fabs_pa
%fabs_a = OpCopyObject %f32 %fabs_a0
%fabs_r = OpExtInst %f32 %ocl fabs %fabs_a
%fabs_r1 = OpCopyObject %f32 %fabs_r
%fabs_po = OpInBoundsPtrAccessChain %p_cw_f32 %fabs_out %fabs_i
OpStore %fabs_po %fabs_r1
OpReturn
OpFunctionEnd
