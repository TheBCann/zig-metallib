; hand-vectors.spvasm: the vector instructions of docs/spirv-plan.md stage 4 (SPIRV-DESIGN section 4),
; one GLCompute kernel per lane count so a refusal by Metal's runtime compiler is attributable:
;   vec2  <2 x i32>: OpCompositeConstruct/Extract/Insert, OpVectorShuffle, OpVectorExtractDynamic/InsertDynamic,
;         vector OpIAdd/OpIMul/OpShiftLeftLogical, vector OpSLessThan + OpSelect with a <2 x bool> condition
;   vec3  <3 x f32>: OpVectorTimesScalar, OpDot, OpFAdd/OpFMul/OpFDiv on vectors, OpAny/OpAll, OpFOrdLessThan vectors
;   vec4  <4 x f32> and <4 x i32>: splat constants (OpConstantComposite), OpVectorShuffle with an undefined lane
;         (0xFFFFFFFF), lane-wise OpSelect, OpConvertFToS/OpConvertSToF on vectors, OpBitcast <4 x i32> <-> <4 x f32>
;   vec8  <8 x i32> (Vector16 capability): arithmetic, shifts, compare + select, reduction by extracts
; Standard Vulkan compute shape: bindings 0 in0v vec4<i32>[1024] (NonWritable), 1 in1v vec4<i32>[1024]
; (NonWritable), 2 outv vec4<i32>[1024], ArrayStride 16; floats travel through the i32 lanes via OpBitcast.
; Hand-written for this project's corpus in tools/spirv/asm.zig syntax (spirv-as compatible).
; SPIR-V
; Version: 1.3
; Generator: 0x00000000
OpCapability Shader
OpCapability Vector16
OpExtension "SPV_KHR_storage_buffer_storage_class"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %k_vec2 "vec2" %gid
OpEntryPoint GLCompute %k_vec3 "vec3" %gid
OpEntryPoint GLCompute %k_vec4 "vec4" %gid
OpEntryPoint GLCompute %k_vec8 "vec8" %gid
OpExecutionMode %k_vec2 LocalSize 64 1 1
OpExecutionMode %k_vec3 LocalSize 64 1 1
OpExecutionMode %k_vec4 LocalSize 64 1 1
OpExecutionMode %k_vec8 LocalSize 64 1 1
OpName %k_vec2 "vec2"
OpName %k_vec3 "vec3"
OpName %k_vec4 "vec4"
OpName %k_vec8 "vec8"
OpName %in0v "in0v"
OpName %in1v "in1v"
OpName %outv "outv"
OpName %gid "gid"
OpName %VBuf "VBuf"
OpMemberName %VBuf 0 "data"
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %v4arr ArrayStride 16
OpDecorate %VBuf Block
OpMemberDecorate %VBuf 0 Offset 0
OpDecorate %in0v DescriptorSet 0
OpDecorate %in0v Binding 0
OpDecorate %in0v NonWritable
OpDecorate %in1v DescriptorSet 0
OpDecorate %in1v Binding 1
OpDecorate %in1v NonWritable
OpDecorate %outv DescriptorSet 0
OpDecorate %outv Binding 2
%void = OpTypeVoid
%bool = OpTypeBool
%u32 = OpTypeInt 32 0
%i32 = OpTypeInt 32 1
%f32 = OpTypeFloat 32
%v3u32 = OpTypeVector %u32 3
%v2i32 = OpTypeVector %i32 2
%v3i32 = OpTypeVector %i32 3
%v4i32 = OpTypeVector %i32 4
%v8i32 = OpTypeVector %i32 8
%v2bool = OpTypeVector %bool 2
%v3bool = OpTypeVector %bool 3
%v4bool = OpTypeVector %bool 4
%v8bool = OpTypeVector %bool 8
%v3f32 = OpTypeVector %f32 3
%v4f32 = OpTypeVector %f32 4
%fn_void = OpTypeFunction %void
%c0 = OpConstant %u32 0
%c1 = OpConstant %u32 1
%c1024 = OpConstant %u32 1024
%ci0 = OpConstant %i32 0
%ci1 = OpConstant %i32 1
%ci2 = OpConstant %i32 2
%ci3 = OpConstant %i32 3
%ci7 = OpConstant %i32 7
%ci_1 = OpConstant %i32 -1
%f1 = OpConstant %f32 1
%f2 = OpConstant %f32 2
%f_half = OpConstant %f32 0.5
%v2_1_2 = OpConstantComposite %v2i32 %ci1 %ci2
%v4_splat3 = OpConstantComposite %v4i32 %ci3 %ci3 %ci3 %ci3
%v4_shift = OpConstantComposite %v4i32 %ci0 %ci1 %ci2 %ci3
%v4f_splat2 = OpConstantComposite %v4f32 %f2 %f2 %f2 %f2
%v3f_1 = OpConstantComposite %v3f32 %f1 %f_half %f2
%v8_splat7 = OpConstantComposite %v8i32 %ci7 %ci7 %ci7 %ci7 %ci7 %ci7 %ci7 %ci7
%v8_shift = OpConstantComposite %v8i32 %ci0 %ci1 %ci2 %ci3 %ci0 %ci1 %ci2 %ci3
%v4arr = OpTypeArray %v4i32 %c1024
%VBuf = OpTypeStruct %v4arr
%p_VBuf = OpTypePointer StorageBuffer %VBuf
%p_sb_v4 = OpTypePointer StorageBuffer %v4i32
%p_in_v3u32 = OpTypePointer Input %v3u32
%gid = OpVariable %p_in_v3u32 Input
%in0v = OpVariable %p_VBuf StorageBuffer
%in1v = OpVariable %p_VBuf StorageBuffer
%outv = OpVariable %p_VBuf StorageBuffer
; vec2
%k_vec2 = OpFunction %void None %fn_void
%v2_entry = OpLabel
%v2_g = OpLoad %v3u32 %gid
%v2_i = OpCompositeExtract %u32 %v2_g 0
%v2_pa = OpAccessChain %p_sb_v4 %in0v %c0 %v2_i
%v2_a4 = OpLoad %v4i32 %v2_pa
%v2_pb = OpAccessChain %p_sb_v4 %in1v %c0 %v2_i
%v2_b4 = OpLoad %v4i32 %v2_pb
%v2_a = OpVectorShuffle %v2i32 %v2_a4 %v2_a4 0 1
%v2_b = OpVectorShuffle %v2i32 %v2_b4 %v2_b4 2 3
%v2_a0 = OpCompositeExtract %i32 %v2_a 0
%v2_b1 = OpCompositeExtract %i32 %v2_b 1
%v2_c = OpCompositeConstruct %v2i32 %v2_b1 %v2_a0
%v2_d = OpCompositeInsert %v2i32 %ci7 %v2_c 1
%v2_sh = OpVectorShuffle %v2i32 %v2_a %v2_d 3 0
%v2_idx = OpBitwiseAnd %u32 %v2_i %c1
%v2_dyn = OpVectorExtractDynamic %i32 %v2_sh %v2_idx
%v2_ins = OpVectorInsertDynamic %v2i32 %v2_b %v2_dyn %v2_idx
%v2_add = OpIAdd %v2i32 %v2_ins %v2_1_2
%v2_mul = OpIMul %v2i32 %v2_add %v2_a
%v2_shl = OpShiftLeftLogical %v2i32 %v2_mul %v2_1_2
%v2_lt = OpSLessThan %v2bool %v2_shl %v2_b
%v2_sel = OpSelect %v2i32 %v2_lt %v2_shl %v2_b
%v2_r = OpVectorShuffle %v4i32 %v2_sel %v2_a 0 1 2 3
%v2_po = OpAccessChain %p_sb_v4 %outv %c0 %v2_i
OpStore %v2_po %v2_r
OpReturn
OpFunctionEnd
; vec3
%k_vec3 = OpFunction %void None %fn_void
%v3_entry = OpLabel
%v3_g = OpLoad %v3u32 %gid
%v3_i = OpCompositeExtract %u32 %v3_g 0
%v3_pa = OpAccessChain %p_sb_v4 %in0v %c0 %v3_i
%v3_a4 = OpLoad %v4i32 %v3_pa
%v3_pb = OpAccessChain %p_sb_v4 %in1v %c0 %v3_i
%v3_b4 = OpLoad %v4i32 %v3_pb
%v3_a4f = OpBitcast %v4f32 %v3_a4
%v3_b4f = OpBitcast %v4f32 %v3_b4
%v3_a = OpVectorShuffle %v3f32 %v3_a4f %v3_a4f 0 1 2
%v3_b = OpVectorShuffle %v3f32 %v3_b4f %v3_b4f 0 1 2
%v3_ts = OpVectorTimesScalar %v3f32 %v3_a %f_half
%v3_add = OpFAdd %v3f32 %v3_ts %v3_b
%v3_mul = OpFMul %v3f32 %v3_add %v3f_1
%v3_div = OpFDiv %v3f32 %v3_mul %v3f_1
%v3_dot = OpDot %f32 %v3_div %v3_b
%v3_lt = OpFOrdLessThan %v3bool %v3_a %v3_b
%v3_any = OpAny %bool %v3_lt
%v3_all = OpAll %bool %v3_lt
%v3_s = OpSelect %f32 %v3_any %v3_dot %f1
%v3_t = OpSelect %f32 %v3_all %f2 %v3_s
%v3_r3 = OpCompositeInsert %v3f32 %v3_t %v3_div 2
%v3_r = OpVectorShuffle %v4f32 %v3_r3 %v3_a 0 1 2 5
%v3_ri = OpBitcast %v4i32 %v3_r
%v3_po = OpAccessChain %p_sb_v4 %outv %c0 %v3_i
OpStore %v3_po %v3_ri
OpReturn
OpFunctionEnd
; vec4
%k_vec4 = OpFunction %void None %fn_void
%v4_entry = OpLabel
%v4_g = OpLoad %v3u32 %gid
%v4_i = OpCompositeExtract %u32 %v4_g 0
%v4_pa = OpAccessChain %p_sb_v4 %in0v %c0 %v4_i
%v4_a = OpLoad %v4i32 %v4_pa
%v4_pb = OpAccessChain %p_sb_v4 %in1v %c0 %v4_i
%v4_b = OpLoad %v4i32 %v4_pb
%v4_and = OpBitwiseAnd %v4i32 %v4_a %v4_splat3
%v4_shl = OpShiftLeftLogical %v4i32 %v4_b %v4_shift
%v4_ashr = OpShiftRightArithmetic %v4i32 %v4_shl %v4_shift
%v4_xor = OpBitwiseXor %v4i32 %v4_and %v4_ashr
%v4_sw = OpVectorShuffle %v4i32 %v4_xor %v4_a 3 2 0xFFFFFFFF 5
%v4_lt = OpSLessThan %v4bool %v4_sw %v4_b
%v4_sel = OpSelect %v4i32 %v4_lt %v4_sw %v4_b
%v4_f = OpConvertSToF %v4f32 %v4_sel
%v4_fm = OpFMul %v4f32 %v4_f %v4f_splat2
%v4_af = OpBitcast %v4f32 %v4_a
%v4_fa = OpFAdd %v4f32 %v4_fm %v4_af
%v4_ri = OpConvertFToS %v4i32 %v4_fa
%v4_rb = OpBitcast %v4i32 %v4_fa
%v4_r = OpIAdd %v4i32 %v4_ri %v4_rb
%v4_po = OpAccessChain %p_sb_v4 %outv %c0 %v4_i
OpStore %v4_po %v4_r
OpReturn
OpFunctionEnd
; vec8
%k_vec8 = OpFunction %void None %fn_void
%v8_entry = OpLabel
%v8_g = OpLoad %v3u32 %gid
%v8_i = OpCompositeExtract %u32 %v8_g 0
%v8_pa = OpAccessChain %p_sb_v4 %in0v %c0 %v8_i
%v8_a4 = OpLoad %v4i32 %v8_pa
%v8_pb = OpAccessChain %p_sb_v4 %in1v %c0 %v8_i
%v8_b4 = OpLoad %v4i32 %v8_pb
%v8_a = OpVectorShuffle %v8i32 %v8_a4 %v8_b4 0 1 2 3 4 5 6 7
%v8_b = OpVectorShuffle %v8i32 %v8_a4 %v8_b4 7 6 5 4 3 2 1 0
%v8_add = OpIAdd %v8i32 %v8_a %v8_b
%v8_mul = OpIMul %v8i32 %v8_add %v8_splat7
%v8_shr = OpShiftRightLogical %v8i32 %v8_mul %v8_shift
%v8_lt = OpSLessThan %v8bool %v8_shr %v8_a
%v8_sel = OpSelect %v8i32 %v8_lt %v8_shr %v8_a
%v8_sub = OpISub %v8i32 %v8_sel %v8_b
%v8_e0 = OpCompositeExtract %i32 %v8_sub 0
%v8_e1 = OpCompositeExtract %i32 %v8_sub 1
%v8_e2 = OpCompositeExtract %i32 %v8_sub 2
%v8_e3 = OpCompositeExtract %i32 %v8_sub 3
%v8_e4 = OpCompositeExtract %i32 %v8_sub 4
%v8_e5 = OpCompositeExtract %i32 %v8_sub 5
%v8_e6 = OpCompositeExtract %i32 %v8_sub 6
%v8_e7 = OpCompositeExtract %i32 %v8_sub 7
%v8_x1 = OpBitwiseXor %i32 %v8_e0 %v8_e1
%v8_x2 = OpBitwiseXor %i32 %v8_x1 %v8_e2
%v8_x3 = OpBitwiseXor %i32 %v8_x2 %v8_e3
%v8_s4 = OpIAdd %i32 %v8_e4 %v8_e5
%v8_s5 = OpIAdd %i32 %v8_s4 %v8_e6
%v8_s6 = OpIAdd %i32 %v8_s5 %v8_e7
%v8_lo = OpVectorShuffle %v4i32 %v8_sub %v8_sub 0 1 2 3
%v8_r1 = OpCompositeInsert %v4i32 %v8_x3 %v8_lo 0
%v8_r = OpCompositeInsert %v4i32 %v8_s6 %v8_r1 1
%v8_po = OpAccessChain %p_sb_v4 %outv %c0 %v8_i
OpStore %v8_po %v8_r
OpReturn
OpFunctionEnd
