%outb = OpVariable %_ptr_Uniform_Out Uniform
%gl_WorkGroupID = OpVariable %_ptr_Input_v3uint Input
%uint_16 = OpConstant %uint 16
%_arr_uint_uint_16 = OpTypeArray %uint %uint_16
