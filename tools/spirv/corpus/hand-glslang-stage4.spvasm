; hand-glslang-stage4.spvasm: barriers and atomics in the shapes glslang emits (docs/spirv.md "Barriers and
; atomics"), written by hand in tools/spirv/asm.zig syntax in the shape glslangValidator -V (target Vulkan 1.0,
; no optimizer) gives the GLSL below, with both entry points in one module. It is not glslang's output: glslang
; is not installed here, so the shape was never compared with a real build. Generator 0x0008000b is glslang's id,
; set to imitate it (nothing in the lowering keys on it).
;
;   #version 450
;   layout(local_size_x = 64) in;
;   layout(std430, binding = 0) readonly buffer In { uint data[]; } inb;
;   layout(std430, binding = 1) buffer Out { uint data[]; } outb;
;   layout(std430, binding = 2) buffer Counters { uint count; uint slot[16]; } cnt;
;   shared uint sdata[64];
;
;   void reduce() {                                   // tree reduction, one sum per workgroup
;     uint lid = gl_LocalInvocationID.x;
;     sdata[lid] = inb.data[gl_GlobalInvocationID.x];
;     barrier();
;     for (uint s = gl_WorkGroupSize.x / 2u; s > 0u; s >>= 1) {
;       if (lid < s) sdata[lid] += sdata[lid + s];
;       barrier();                                    // in a loop bounded by a uniform value
;     }
;     if (lid == 0u) outb.data[gl_WorkGroupID.x] = sdata[0];
;   }
;   void atomics() {                                  // atomicAdd and atomicCompSwap on an SSBO
;     uint gid = gl_GlobalInvocationID.x;
;     uint old = atomicAdd(cnt.count, 1u);
;     outb.data[gid] = old;
;     uint prev = atomicCompSwap(cnt.slot[gid & 15u], 0u, gid + 1u);
;     outb.data[gid + 4096u] = prev;
;   }
;
; The glslang shape: SPIR-V 1.0 SSBOs (Uniform storage class + BufferBlock, so every atomic pointer is a Uniform
; pointer into device memory), every local an OpVariable Function read and written with OpLoad / OpStore (the loop
; counter `s` too: the uniformity analysis must see through it), builtins read through OpAccessChain on the Input
; variable, struct members indexed by `int` constants, `barrier()` as OpControlBarrier Workgroup Workgroup
; AcquireRelease|WorkgroupMemory (2 2 264), atomicAdd as OpAtomicIAdd Device Relaxed (1 0), atomicCompSwap as
; OpAtomicCompareExchange Device Relaxed Relaxed with Value before Comparator, gl_WorkGroupSize as a BuiltIn
; WorkgroupSize constant composite, structured loops with OpLoopMerge and a continue block.
; tools/spirv/corpus_driver.zig runs both: `reduce` over 4096 inputs against the CPU's per-workgroup sums, `atomics`
; over 4096 threads (the old counter values a permutation of 0..4095; per slot, exactly one thread swapped 0 for
; gid + 1 and every other thread of that slot saw the winner's value).
; SPIR-V
; Version: 1.0
; Generator: 0x0008000b
; Schema: 0
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %reduce "reduce" %gl_LocalInvocationID %gl_GlobalInvocationID %gl_WorkGroupID
OpEntryPoint GLCompute %atomics "atomics" %gl_GlobalInvocationID
OpExecutionMode %reduce LocalSize 64 1 1
OpExecutionMode %atomics LocalSize 64 1 1
OpSource GLSL 450
OpName %reduce "reduce"
OpName %atomics "atomics"
OpName %lid "lid"
OpName %gl_LocalInvocationID "gl_LocalInvocationID"
OpName %sdata "sdata"
OpName %In "In"
OpMemberName %In 0 "data"
OpName %inb "inb"
OpName %gl_GlobalInvocationID "gl_GlobalInvocationID"
OpName %s "s"
OpName %Out "Out"
OpMemberName %Out 0 "data"
