OpBranchConditional %67 %68 %69
%68 = OpLabel
%74 = OpAccessChain %_ptr_Input_uint %gl_WorkGroupID %uint_0
%75 = OpLoad %uint %74
%76 = OpAccessChain %_ptr_Workgroup_uint %sdata %int_0
%77 = OpLoad %uint %76
%78 = OpAccessChain %_ptr_Uniform_uint %outb %int_0 %75
OpStore %78 %77
OpBranch %69
%69 = OpLabel
OpReturn
OpFunctionEnd
%atomics = OpFunction %void None %3
%80 = OpLabel
%gid = OpVariable %_ptr_Function_uint Function
%old = OpVariable %_ptr_Function_uint Function
%prev = OpVariable %_ptr_Function_uint Function
%84 = OpAccessChain %_ptr_Input_uint %gl_GlobalInvocationID %uint_0
%85 = OpLoad %uint %84
