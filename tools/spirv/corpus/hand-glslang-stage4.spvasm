%uint_15 = OpConstant %uint 15
%uint_4096 = OpConstant %uint 4096
%reduce = OpFunction %void None %3
%5 = OpLabel
%lid = OpVariable %_ptr_Function_uint Function
%s = OpVariable %_ptr_Function_uint Function
%14 = OpAccessChain %_ptr_Input_uint %gl_LocalInvocationID %uint_0
%15 = OpLoad %uint %14
OpStore %lid %15
%20 = OpLoad %uint %lid
%27 = OpAccessChain %_ptr_Input_uint %gl_GlobalInvocationID %uint_0
%28 = OpLoad %uint %27
%30 = OpAccessChain %_ptr_Uniform_uint %inb %int_0 %28
%31 = OpLoad %uint %30
%33 = OpAccessChain %_ptr_Workgroup_uint %sdata %20
