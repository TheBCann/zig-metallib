; hand-glsl-std-450.spvasm: one GLCompute entry point per GLSL.std.450 instruction the lowering
; maps (docs/spirv-plan.md stage 1, SPIRV-DESIGN section 4), each in its own kernel so a refusal by
; Metal's runtime compiler is attributable to one instruction. Standard Vulkan compute shape:
; Logical GLSL450, Block structs with DescriptorSet 0 and Binding, BuiltIn GlobalInvocationId,
; LocalSize 64 1 1; every kernel handles element gid.x.
; Bindings: 0 in0 f32[4096] (NonWritable), 1 in1 f32[4096] (NonWritable), 2 out f32[4096],
;           3 in0i i32[4096] (NonWritable), 4 in1i i32[4096] (NonWritable), 5 outi i32[4096],
;           6 in0v vec4<f32>[1024] stride 16 (NonWritable), 7 in1v, 8 outv.
; Unsigned instructions bitcast the i32 inputs; the third operand of a ternary is a + b (a | b for ints).
; Hand-written for this project's corpus in tools/spirv/asm.zig syntax (spirv-as compatible).
; SPIR-V
; Version: 1.3
; Generator: 0x00000000
OpCapability Shader
OpExtension "SPV_KHR_storage_buffer_storage_class"
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %k_FAbs "FAbs" %gid
OpEntryPoint GLCompute %k_FSign "FSign" %gid
OpEntryPoint GLCompute %k_Round "Round" %gid
OpEntryPoint GLCompute %k_RoundEven "RoundEven" %gid
OpEntryPoint GLCompute %k_Trunc "Trunc" %gid
OpEntryPoint GLCompute %k_Floor "Floor" %gid
OpEntryPoint GLCompute %k_Ceil "Ceil" %gid
OpEntryPoint GLCompute %k_Fract "Fract" %gid
OpEntryPoint GLCompute %k_Sqrt "Sqrt" %gid
OpEntryPoint GLCompute %k_InverseSqrt "InverseSqrt" %gid
OpEntryPoint GLCompute %k_Sin "Sin" %gid
OpEntryPoint GLCompute %k_Cos "Cos" %gid
OpEntryPoint GLCompute %k_Tan "Tan" %gid
OpEntryPoint GLCompute %k_Asin "Asin" %gid
OpEntryPoint GLCompute %k_Acos "Acos" %gid
OpEntryPoint GLCompute %k_Atan "Atan" %gid
OpEntryPoint GLCompute %k_Sinh "Sinh" %gid
OpEntryPoint GLCompute %k_Cosh "Cosh" %gid
OpEntryPoint GLCompute %k_Tanh "Tanh" %gid
OpEntryPoint GLCompute %k_Exp "Exp" %gid
OpEntryPoint GLCompute %k_Log "Log" %gid
OpEntryPoint GLCompute %k_Exp2 "Exp2" %gid
OpEntryPoint GLCompute %k_Log2 "Log2" %gid
OpEntryPoint GLCompute %k_Atan2 "Atan2" %gid
OpEntryPoint GLCompute %k_Pow "Pow" %gid
OpEntryPoint GLCompute %k_FMin "FMin" %gid
OpEntryPoint GLCompute %k_FMax "FMax" %gid
OpEntryPoint GLCompute %k_NMin "NMin" %gid
OpEntryPoint GLCompute %k_NMax "NMax" %gid
OpEntryPoint GLCompute %k_Step "Step" %gid
OpEntryPoint GLCompute %k_Fma "Fma" %gid
OpEntryPoint GLCompute %k_FClamp "FClamp" %gid
OpEntryPoint GLCompute %k_FMix "FMix" %gid
OpEntryPoint GLCompute %k_SmoothStep "SmoothStep" %gid
OpEntryPoint GLCompute %k_Ldexp "Ldexp" %gid
OpEntryPoint GLCompute %k_SAbs "SAbs" %gid
OpEntryPoint GLCompute %k_SSign "SSign" %gid
OpEntryPoint GLCompute %k_FindILsb "FindILsb" %gid
OpEntryPoint GLCompute %k_FindSMsb "FindSMsb" %gid
OpEntryPoint GLCompute %k_FindUMsb "FindUMsb" %gid
OpEntryPoint GLCompute %k_SMin "SMin" %gid
OpEntryPoint GLCompute %k_SMax "SMax" %gid
OpEntryPoint GLCompute %k_UMin "UMin" %gid
OpEntryPoint GLCompute %k_UMax "UMax" %gid
OpEntryPoint GLCompute %k_SClamp "SClamp" %gid
OpEntryPoint GLCompute %k_UClamp "UClamp" %gid
OpEntryPoint GLCompute %k_Normalize "Normalize" %gid
OpEntryPoint GLCompute %k_Length "Length" %gid
OpEntryPoint GLCompute %k_Distance "Distance" %gid
OpEntryPoint GLCompute %k_Cross "Cross" %gid
