OpName %VBuf "VBuf"
OpMemberName %FBuf 0 "data"
OpMemberName %IBuf 0 "data"
OpMemberName %VBuf 0 "data"
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %f32arr ArrayStride 4
OpDecorate %i32arr ArrayStride 4
OpDecorate %v4arr ArrayStride 16
OpDecorate %FBuf Block
OpMemberDecorate %FBuf 0 Offset 0
OpDecorate %IBuf Block
OpMemberDecorate %IBuf 0 Offset 0
OpDecorate %VBuf Block
OpMemberDecorate %VBuf 0 Offset 0
OpDecorate %in0 DescriptorSet 0
OpDecorate %in0 Binding 0
OpDecorate %in0 NonWritable
OpDecorate %in1 DescriptorSet 0
OpDecorate %in1 Binding 1
OpDecorate %in1 NonWritable
OpDecorate %out DescriptorSet 0
OpDecorate %out Binding 2
OpDecorate %in0i DescriptorSet 0
OpDecorate %in0i Binding 3
OpDecorate %in0i NonWritable
OpDecorate %in1i DescriptorSet 0
OpDecorate %in1i Binding 4
OpDecorate %in1i NonWritable
OpDecorate %outi DescriptorSet 0
OpDecorate %outi Binding 5
OpDecorate %in0v DescriptorSet 0
OpDecorate %in0v Binding 6
OpDecorate %in0v NonWritable
OpDecorate %in1v DescriptorSet 0
OpDecorate %in1v Binding 7
OpDecorate %in1v NonWritable
OpDecorate %outv DescriptorSet 0
OpDecorate %outv Binding 8
%void = OpTypeVoid
%fn_void = OpTypeFunction %void
%f32 = OpTypeFloat 32
%u32 = OpTypeInt 32 0
%i32 = OpTypeInt 32 1
%v3u32 = OpTypeVector %u32 3
%v4f32 = OpTypeVector %f32 4
%v3f32 = OpTypeVector %f32 3
%c0 = OpConstant %u32 0
%c4096 = OpConstant %u32 4096
%c1024 = OpConstant %u32 1024
%f0 = OpConstant %f32 0
%f32arr = OpTypeArray %f32 %c4096
%i32arr = OpTypeArray %i32 %c4096
%v4arr = OpTypeArray %v4f32 %c1024
%FBuf = OpTypeStruct %f32arr
%IBuf = OpTypeStruct %i32arr
%VBuf = OpTypeStruct %v4arr
%p_FBuf = OpTypePointer StorageBuffer %FBuf
%p_IBuf = OpTypePointer StorageBuffer %IBuf
%p_VBuf = OpTypePointer StorageBuffer %VBuf
%p_sb_f32 = OpTypePointer StorageBuffer %f32
%p_sb_i32 = OpTypePointer StorageBuffer %i32
%p_sb_v4 = OpTypePointer StorageBuffer %v4f32
%p_in_v3u32 = OpTypePointer Input %v3u32
%gid = OpVariable %p_in_v3u32 Input
%in0 = OpVariable %p_FBuf StorageBuffer
%in1 = OpVariable %p_FBuf StorageBuffer
%out = OpVariable %p_FBuf StorageBuffer
%in0i = OpVariable %p_IBuf StorageBuffer
%in1i = OpVariable %p_IBuf StorageBuffer
%outi = OpVariable %p_IBuf StorageBuffer
%in0v = OpVariable %p_VBuf StorageBuffer
%in1v = OpVariable %p_VBuf StorageBuffer
%outv = OpVariable %p_VBuf StorageBuffer
%k_FAbs = OpFunction %void None %fn_void
%FAbs_entry = OpLabel
%FAbs_g = OpLoad %v3u32 %gid
%FAbs_i = OpCompositeExtract %u32 %FAbs_g 0
%FAbs_pa = OpAccessChain %p_sb_f32 %in0 %c0 %FAbs_i
%FAbs_a = OpLoad %f32 %FAbs_pa
%FAbs_r = OpExtInst %f32 %glsl FAbs %FAbs_a
%FAbs_po = OpAccessChain %p_sb_f32 %out %c0 %FAbs_i
OpStore %FAbs_po %FAbs_r
OpReturn
OpFunctionEnd
