%ad_slot = OpBitwiseAnd %u32 %ad_i %c63
%ad_p = OpAccessChain %p_sb_i32 %out %c0 %ad_slot
%ad_0 = OpAtomicIAdd %i32 %ad_p %scope_dev %sem_relaxed %ad_a
%ad_1 = OpAtomicISub %i32 %ad_p %scope_dev %sem_acq_dev %ad_b
%ad_2 = OpAtomicSMin %i32 %ad_p %scope_dev %sem_rel_dev %ad_a
%ad_3 = OpAtomicSMax %i32 %ad_p %scope_dev %sem_acqrel_dev %ad_b
%ad_4 = OpAtomicUMin %i32 %ad_p %scope_dev %sem_relaxed %ad_a
%ad_5 = OpAtomicUMax %i32 %ad_p %scope_dev %sem_relaxed %ad_b
%ad_6 = OpAtomicAnd %i32 %ad_p %scope_dev %sem_relaxed %ad_a
%ad_7 = OpAtomicOr %i32 %ad_p %scope_dev %sem_relaxed %ad_b
%ad_8 = OpAtomicXor %i32 %ad_p %scope_dev %sem_relaxed %ad_a
