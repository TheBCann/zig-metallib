%ac_old = OpAtomicIAdd %i32 %ac_pc %scope_dev %sem_relaxed %ci1
%ac_i1 = OpIAdd %u32 %ac_i %c1
%ac_po = OpAccessChain %p_sb_i32 %out %c0 %ac_i1
OpStore %ac_po %ac_old
OpReturn
OpFunctionEnd
