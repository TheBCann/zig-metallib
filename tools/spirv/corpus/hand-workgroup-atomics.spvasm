%ad_s9 = OpIAdd %i32 %ad_s8 %ad_9
%ad_s10 = OpIAdd %i32 %ad_s9 %ad_10
%ad_s11 = OpIAdd %i32 %ad_s10 %ad_11
%ad_hi = OpIAdd %u32 %ad_i %c64
%ad_po = OpAccessChain %p_sb_i32 %out %c0 %ad_hi
OpStore %ad_po %ad_s11
OpReturn
OpFunctionEnd
; atomic_workgroup
%k_atomic_workgroup = OpFunction %void None %fn_void
%aw_entry = OpLabel
%aw_g = OpLoad %v3u32 %gid
