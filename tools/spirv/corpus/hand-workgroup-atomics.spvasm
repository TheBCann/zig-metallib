%ad_10 = OpAtomicCompareExchange %i32 %ad_p %scope_dev %sem_acqrel_dev %sem_relaxed %ci5 %ad_b
%ad_11 = OpAtomicLoad %i32 %ad_p %scope_dev %sem_acq_dev
OpAtomicStore %ad_p %scope_dev %sem_rel_dev %ad_a
%ad_s1 = OpIAdd %i32 %ad_0 %ad_1
%ad_s2 = OpIAdd %i32 %ad_s1 %ad_2
%ad_s3 = OpIAdd %i32 %ad_s2 %ad_3
%ad_s4 = OpIAdd %i32 %ad_s3 %ad_4
%ad_s5 = OpIAdd %i32 %ad_s4 %ad_5
