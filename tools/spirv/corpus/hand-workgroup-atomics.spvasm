%aw_0 = OpAtomicIAdd %i32 %aw_p %scope_wg %sem_relaxed %aw_a
%aw_1 = OpAtomicISub %i32 %aw_p %scope_wg %sem_acq_wg %ci1
%aw_2 = OpAtomicSMin %i32 %aw_p %scope_wg %sem_rel_wg %aw_a
%aw_3 = OpAtomicSMax %i32 %aw_p %scope_wg %sem_acqrel_wg %ci_3
