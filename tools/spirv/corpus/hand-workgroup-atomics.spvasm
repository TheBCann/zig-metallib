; atomic_minmax64
%k_atomic_minmax64 = OpFunction %void None %fn_void
%mm_entry = OpLabel
%mm_g = OpLoad %v3u32 %gid
%mm_i = OpCompositeExtract %u32 %mm_g 0
%mm_pa = OpAccessChain %p_sb_i32 %in0 %c0 %mm_i
%mm_a = OpLoad %i32 %mm_pa
%mm_pb = OpAccessChain %p_sb_i32 %in1 %c0 %mm_i
