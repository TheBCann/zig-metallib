%aw_s1 = OpIAdd %i32 %aw_0 %aw_1
%aw_s2 = OpIAdd %i32 %aw_s1 %aw_2
%aw_s3 = OpIAdd %i32 %aw_s2 %aw_3
%aw_s4 = OpIAdd %i32 %aw_s3 %aw_4
%aw_s5 = OpIAdd %i32 %aw_s4 %aw_5
